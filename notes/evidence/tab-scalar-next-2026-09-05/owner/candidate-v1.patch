+int lj_tab_test_nextscalar_rooted_try(lua_State *L, cTValue *tabroot,
+				    cTValue *keyroot, TValue *outkey,
+				    TValue *outval, uint32_t *nextidx)
+{
+  return tab_nextscalar_rooted_try(L, tabroot, keyroot, outkey, outval,
+				 nextidx);
+}
