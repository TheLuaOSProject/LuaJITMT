+static int safepoint_try_resume_owner_roots(TGState *tg)
+{
+  global_State *g = tg ? tg->gl : NULL;
+  uint64_t epoch;
+  uint32_t cycle;
+  /* Only the physical owner after native close may clear this old wake. A new
+  ** leader then cannot consume a later request remotely while this bounded
+  ** helper runs; its counted reqmask survives for the repair below. */
+  if (!g || tg != lj_thr_get_tg_fallback(g) ||
+      lj_tg_in_native_acq(tg) != 0 || lj_tg_jit_active_acq(tg) ||
+      lj_tg_flags_test_acq(tg, TGF_DEAD|TGF_STOPREQ_FRESH))
+    return 0;
+  epoch = lj_tg_hs_resume_epoch_acq(tg);
+  cycle = lj_tg_hs_resume_cycle_acq(tg);
+  if (epoch == 0 || cycle == 0 || gc2_hs_epoch_acq(g) != epoch ||
+      gc2_phase_acq(g) != LJ_GC2_MARK || gc2_cycle_acq(g) != cycle ||
+      lj_tg_hs_resume_epoch_acq(tg) != epoch || lj_tg_reqmask_acq(tg) != 0)
+    return 0;
+  safepoint_resume_test_pause(g, tg, epoch,
+			     LJ_SAFEPOINT_RESUME_TEST_BEFORE_CLEAR);
+  /* Keeping poll set would spin at patched bytecodes which redispatch the
+  ** same instruction. Clear the old edge and repair any newer counted one.
+  ** Native close's SC fence pairs with request publication: a later request
+  ** either remained owner-pending here or arrived after this clear/repair. */
+  safepoint_clear_poll(tg);
+  safepoint_restore_counted_poll(tg);
+  return 1;
+}
+
+static void safepoint_publish_owner_roots_resume(global_State *g, TGState *tg,
+					       uint32_t actions,
+					       uint64_t epoch,
+					       uint32_t cycle)
+{
+  if (actions != (LJ_GC2_HS_SCAN_OWNER_ROOTS|LJ_GC2_HS_FLUSH_SSB) ||
+      epoch == 0 || cycle == 0 || gc2_phase_acq(g) != LJ_GC2_MARK ||
+      gc2_cycle_acq(g) != cycle)
+    return;
+  /* Root leases, remote SSB publication/fresh-buffer installation and the
+  ** unconditional allocator-accounting flush are all finished. Publish before
+  ** the pending decrement, so a stopped executor leaves durable local evidence.
+  ** This does not certify empty SSBs or discharge root-scan retry/NEEDSCAN. */
+  lj_tg_hs_resume_cycle_rel(tg, cycle);
+  lj_tg_hs_resume_epoch_rel(tg, epoch);
+  safepoint_resume_test_pause(g, tg, epoch,
+			     LJ_SAFEPOINT_RESUME_TEST_PUBLISHED);
+  lj_tg_poll_futex_wake(tg, 1);
 }
 
