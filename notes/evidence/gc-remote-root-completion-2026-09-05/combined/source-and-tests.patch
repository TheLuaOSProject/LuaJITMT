+/* The unique remote executor may resume its completed owner before the
+** remaining handshake tail. All requests, native transitions, root scans,
+** MARK/IDLE transitions, SSB publication and Lua state claims are real. */
+typedef struct Probe {
+  global_State *g;
+  TGState *owner;
+  TGState peer, late;
+  lua_State *L;
+  GCtab *root;
+  LJStateOwner owner_word;
