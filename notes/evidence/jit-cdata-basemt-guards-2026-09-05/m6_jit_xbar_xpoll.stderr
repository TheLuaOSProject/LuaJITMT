+ LUA_PATH='/tmp/lj-ffi-owned-trace-20260905-pmxukjxp/canonical/tests/lib/?.lua;/tmp/lj-ffi-owned-trace-20260905-pmxukjxp/canonical/src/?.lua;/tmp/lj-ffi-owned-trace-20260905-pmxukjxp/canonical/src/jit/?.lua;;' '/tmp/lj-ffi-owned-trace-20260905-pmxukjxp/canonical/src/luajit' '-e' 'local trace_count = require("jit_harness").trace_count

jit.flush()
jit.opt.start("hotloop=1", "hotexit=1")
local h = { stable = 0 }
for i = 1, 200 do
  h.stable = i
end
assert(h.stable == 200)
assert(trace_count(200) > 0, "existing hash table store did not trace")

jit.flush()
jit.opt.start("hotloop=1", "hotexit=1")
local a = { 0 }
for i = 1, 200 do
  a[1] = i
end
assert(a[1] == 200)
assert(trace_count(200) > 0, "existing array table store did not trace")

jit.flush()
jit.opt.start("hotloop=1", "hotexit=1")
local hn = {}
for i = 1, 200 do
  hn["k" .. i] = i
end
assert(hn.k200 == 200)
assert(trace_count(200) > 0, "new string hash table store did not trace")

jit.flush()
jit.opt.start("hotloop=1", "hotexit=1")
local function array_insert(n)
  local out = { 0 }
  for i = 1, n do
    local an = {}
    an[1] = i
    out = an
  end
  return out
end
local an = array_insert(80)
assert(an[1] == 80)
assert(trace_count(200) > 0, "fresh array slot table store did not trace")
'
ok m5_jit_hash_store_nyi
ok m6_jit_xbar_xpoll
