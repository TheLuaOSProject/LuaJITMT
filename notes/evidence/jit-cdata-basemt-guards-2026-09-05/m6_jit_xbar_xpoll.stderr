+ LUA_PATH='/tmp/lj-ffi-owned-trace-20260905-pmxukjxp/canonical/tests/lib/?.lua;/tmp/lj-ffi-owned-trace-20260905-pmxukjxp/canonical/src/?.lua;/tmp/lj-ffi-owned-trace-20260905-pmxukjxp/canonical/src/jit/?.lua;;' '/tmp/lj-ffi-owned-trace-20260905-pmxukjxp/canonical/src/luajit' '-e' 'local threading = require("threading")
