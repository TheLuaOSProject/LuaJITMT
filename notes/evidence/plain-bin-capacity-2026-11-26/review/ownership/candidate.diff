+typedef struct ArenaBinWalk {
+  const LJArenaFreeRun *checkpoint;
+  uint64_t power;
+  uint64_t distance;
+} ArenaBinWalk;
+
+/* Brent's cycle detector observes only the ordinary validated traversal.
+** Comparing a saved pointer grants no body authority and never dereferences
+** a second, unvalidated fast pointer. A long acyclic bin is valid capacity,
+** not evidence of corruption or permission to disconnect its suffix. */
+static LJ_AINLINE int arena_bin_walk_cycle(ArenaBinWalk *walk,
+                                         const LJArenaFreeRun *run)
+{
+  if (walk->power == 0) {
+    walk->checkpoint = run;
+    walk->power = 1;
+    return 0;
+  }
+  if (run == walk->checkpoint)
+    return 1;
+  if (++walk->distance == walk->power) {
+    walk->checkpoint = run;
+    walk->distance = 0;
+    if (walk->power <= ~(uint64_t)0 / 2u)
+      walk->power *= 2u;
+  }
+  return 0;
+}
