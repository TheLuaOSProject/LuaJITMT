+/* No allocation, polling or yield: the caller's live arguments remain valid
+** throughout this attempt. A lost publication leaves only unexposed tail
+** bytes; another writer can always copy the committed prefix and proceed. */
+static int bufx_append_tail(lua_State *L, LJBuffer *buf, BufPin *pin,
+                            const char *p, MSize n)
+{
+  MSize w = bufx_w(pin->range);
+  uint64_t expected = w;
+  UNUSED(L);
+  if (!pin->store || pin->store->ref || n > pin->store->capacity - w ||
+      !la_cas64(&pin->store->claimed, &expected, BUFX_WRITING | w,
+                LA_ACQ_REL, LA_ACQ))
+    return 0;
+  bufx_test(L, buf, LJ_BUF_TEST_TAIL_CLAIMED);
+  memcpy((char *)(pin->store+1) + w, p, n);
+  return bufx_endwrite(buf, pin, w + n) ? 1 : -1;
+}
