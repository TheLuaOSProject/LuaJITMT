+ LUA_PATH='/tmp/lj-mode0-poll-fix-20260905-qn7zwzl_/canonical/tests/lib/?.lua;/tmp/lj-mode0-poll-fix-20260905-qn7zwzl_/canonical/src/?.lua;/tmp/lj-mode0-poll-fix-20260905-qn7zwzl_/canonical/src/jit/?.lua;;' timeout '20s' '/tmp/lj-mode0-poll-fix-20260905-qn7zwzl_/canonical/src/luajit' '-e' 'local threading = require("threading")
