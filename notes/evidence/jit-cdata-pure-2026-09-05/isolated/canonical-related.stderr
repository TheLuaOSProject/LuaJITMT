+ LUA_PATH='/tmp/lj-premt-cdata-hoist-20260905-oa96m15y/canonical/tests/lib/?.lua;/tmp/lj-premt-cdata-hoist-20260905-oa96m15y/canonical/src/?.lua;/tmp/lj-premt-cdata-hoist-20260905-oa96m15y/canonical/src/jit/?.lua;;' '/tmp/lj-premt-cdata-hoist-20260905-oa96m15y/canonical/src/luajit' '-e' 'local ffi = require("ffi")
local threading = require("threading")
local util = require("jit.util")
local dst = ffi.new("uint8_t[512]")
local src = ffi.new("uint8_t[512]")
jit.opt.start("hotloop=1", "hotexit=1")
assert(threading.gcworkers(1) == 0)
for i = 1, 80 do ffi.copy(dst, src, 512) end
assert(util.traceinfo(1), "FFI copy loop did not trace")
assert(threading.gcworkers(0) == 1)
'
+ LUA_PATH='/tmp/lj-premt-cdata-hoist-20260905-oa96m15y/canonical/tests/lib/?.lua;/tmp/lj-premt-cdata-hoist-20260905-oa96m15y/canonical/src/?.lua;/tmp/lj-premt-cdata-hoist-20260905-oa96m15y/canonical/src/jit/?.lua;;' '/tmp/lj-premt-cdata-hoist-20260905-oa96m15y/canonical/src/luajit' '-e' 'local ffi = require("ffi")
