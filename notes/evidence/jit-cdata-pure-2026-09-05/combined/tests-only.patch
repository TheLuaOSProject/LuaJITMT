+/* Pure-loop unroll scope must close on a real protected OOM. */
+#include <assert.h>
+#include <stdio.h>
+#include "lua.h"
+#include "lauxlib.h"
+#include "lualib.h"
+#include "lj_obj.h"
+#include "lj_jit.h"
+#include "lj_dispatch.h"
+#include "lj_gc.h"
+#include "lj_err.h"
