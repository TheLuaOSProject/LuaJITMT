-  uint64_t state;  /* Low 32 bits: dirty epoch, high 32 bits: scan cycle. */
+  union {
+    la_u128 proof;
+    struct {
+      uint64_t state;  /* Low 32: dirty serial, high 32: covered cycle. */
+      uint64_t era;    /* Non-wrapping authority for serial renewal. */
