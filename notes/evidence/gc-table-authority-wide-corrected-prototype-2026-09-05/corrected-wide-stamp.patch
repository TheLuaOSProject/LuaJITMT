+/* Prototype: exact CX16 snapshot, with no mixed-width read optimization. */
+static LJ_AINLINE la_u128 lj_arena_gc2_stamp_snapshot(LJGC2TabStamp *stamp)
+{
+  la_u128 exact = { 0, 0 }, zero = { 0, 0 };
+  (void)la_cas128(&stamp->proof, &exact, zero);
+  return exact;
