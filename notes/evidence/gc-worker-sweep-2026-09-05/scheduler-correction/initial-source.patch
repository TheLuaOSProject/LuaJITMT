+/* Acquire the same worker/phase exclusion required by the synthetic bridge
+** publisher. A sampled busy token never authorizes this fixture to borrow it. */
+static void claim_synthetic_sweep_worker(global_State *g)
+{
+  int i;
+  for (i = 0; i < 1000; i++) {
+    uint32_t expect = 0;
+    if (gc2_cycle_leader_acq(g) == 0 &&
+        gc2_smr_reclaiming_acq(g) == 0 &&
+        gc2_worker_active_cas(g, &expect, 1)) {
+      if (gc2_cycle_leader_acq(g) == 0 &&
+          gc2_smr_reclaiming_acq(g) == 0)
+        return;
+      gc2_worker_active_rel(g, 0);
+    }
+    sleep_ns(1000000L);
+  }
+  assert(0 && "synthetic SWEEP worker claim timed out");
+}
+
+static void release_synthetic_sweep_worker(global_State *g)
+{
+  gc2_worker_active_rel(g, 0);
+  lj_gc2_test_worker_wake(g);
+}
+
 static void mark_worker_tgs_sweep_ready(global_State *g, uint32_t sweep_cycle)
 {
   uint32_t i;
@@ -373,11 +399,52 @@ static void mark_worker_tgs_sweep_ready(global_State *g, uint32_t sweep_cycle)
     TGState *worker = gc2_worker_tg_acq(g, i);
     if (!worker)
       continue;
+    assert(worker->alloc.needsweep[LJ_ARENAK_TRAVERSABLE] == NULL);
+    assert(worker->alloc.quarantine[LJ_ARENAK_TRAVERSABLE] == NULL);
     worker->alloc.prepare_epoch = sweep_cycle;
     worker->alloc.sweep_epoch = sweep_cycle;
   }
 }
 
+static void test_manual_sweep_close_requires_ready(global_State *g, TGState *tg)
+{
+  uint32_t sweep_cycle;
+  uint64_t closes0 = gc2_sweep_to_idle_acq(g);
+
+  /* The negative and positive close use the same uncontended synthetic phase.
+  ** No pool or peer can make the negative return zero by owning its token. */
+  assert(gc2_n_workers_acq(g) == 0);
+  assert(gc2_n_threads_acq(g) == 1);
+  assert(gc2_phase_acq(g) == LJ_GC2_IDLE);
+  claim_synthetic_sweep_worker(g);
+  sweep_cycle = gc2_cycle_inc_acqrel(g);
+  test_publish_sweep_phase(g);
+  assert(tg->alloc.needsweep[LJ_ARENAK_TRAVERSABLE] == NULL);
+  assert(tg->alloc.quarantine[LJ_ARENAK_TRAVERSABLE] == NULL);
+  tg->alloc.prepare_epoch = sweep_cycle;
+  tg->alloc.sweep_epoch = sweep_cycle;
+  release_synthetic_sweep_worker(g);
+
+  assert(gc2_worker_active_acq(g) == 0);
+  assert(gc2_cycle_leader_acq(g) == 0);
+  assert(gc2_smr_reclaiming_acq(g) == 0);
+  assert(!lj_gc2_sweep_needs_prepare(g));
+  assert(!lj_gc2_sweep_pending(g));
+  assert(gc2_sweep_bridge_ready_acq(g) == 0);
+  assert(lj_gc2_sweep_to_idle(g) == 0);
+  assert(gc2_phase_acq(g) == LJ_GC2_SWEEP);
+  assert(gc2_worker_active_acq(g) == 0);
+  assert(gc2_cycle_leader_acq(g) == 0);
+
+  claim_synthetic_sweep_worker(g);
+  lj_gc2_sweep_bridge_ready(g);
+  assert(gc2_sweep_bridge_ready_acq(g) == 1);
+  release_synthetic_sweep_worker(g);
+  assert(lj_gc2_sweep_to_idle(g) == 1);
+  assert(gc2_phase_acq(g) == LJ_GC2_IDLE);
+  assert(gc2_sweep_to_idle_acq(g) == closes0 + 1u);
+}
