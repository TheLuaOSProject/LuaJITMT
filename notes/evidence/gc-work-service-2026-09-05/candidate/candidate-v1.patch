+/* Select at most one scheduling unit under the existing worker claim. These
+** are source transfers/attempts, not payload completion or allocation credit.
+** Retain only a scalar class across claims: an always-busy SSB/grey source must
+** not consume every quota before recovery gets a turn, including limit == 1.
+** Advance before trying a class so a retained/requeued head cannot also retain
+** first choice after its mandatory deferral. Empty classes cost one probe;
+** there is at most one circular pass before returning without work.
+**
+** A non-NULL tg carries only the caller's pre-existing owner-private SSB
+** authority. Worker drains flush their logical owner's suffix before claiming
+** and pass NULL here; the selector never borrows another owner's active SSB.
+*/
+static uint32_t gc2_graph_drain_one_owned(global_State *g, TGState *tg,
+                                        uint32_t *kindp, int *stop_quantump)
+{
+  uint32_t start = la_load32_rlx(&g->gc2.graph_next_class), i;
+  uint64_t defer0 = gc2_deferred_epoch_acq(g);
+  lj_assertG(gc2_worker_active_acq(g) != 0, "graph selection without worker");
+  if (start >= GC2_GRAPH_CLASSES)
+    start = GC2_GRAPH_PUBLISHED;
+  *stop_quantump = 0;
+  for (i = 0; i < GC2_GRAPH_CLASSES; i++) {
+    uint32_t kind = (start + i) % GC2_GRAPH_CLASSES, n = 0;
+    la_store32_rlx(&g->gc2.graph_next_class,
+                  (kind + 1u) % GC2_GRAPH_CLASSES);
+    if (kindp)
+      *kindp = kind;
+    if (kind == GC2_GRAPH_PUBLISHED) {
+      n = gc2_drain_published_ssb_to_grey(g, 1);
+    } else if (kind == GC2_GRAPH_ACTIVE) {
+      if (tg && !lj_tg_flags_test_acq(tg, TGF_DEAD))
+        n = gc2_drain_active_ssb_to_grey(g, tg, 1);
+    } else if (kind == GC2_GRAPH_GREY) {
+      n = gc2_drain_grey(g, 1, stop_quantump);
+    } else {
+      n = gc2_recovery_drain_owned(g, 1, stop_quantump);
+    }
+    if (gc2_deferred_epoch_acq(g) != defer0)
+      *stop_quantump = 1;
+    if (n || *stop_quantump)
+      return n;
+  }
+  return 0;
+}
