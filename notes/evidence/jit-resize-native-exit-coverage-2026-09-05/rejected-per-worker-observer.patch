+-- Live trace counts are shared and can fall during collection; traceinfo also
+-- returns no snapshot when a peer owns the recorder. Observe native exits in
+-- this worker's actual resize loop instead of subtracting two global counts.
+local function watch_worker_jit_exits(jitmod)
+  local exits = 0
+  local function onexit() exits = exits + 1 end
+  local function finish()
+    jitmod.attach(onexit)
+    return exits
+  end
+  jitmod.off(onexit, true)
+  jitmod.off(finish, true)
+  jitmod.attach(onexit, "texit")
+  return finish
+end
+jit.off(watch_worker_jit_exits, true)
+
 local function jit_store_worker(tbl, ready, start, key, n)
   local okjit, jitmod = pcall(require, "jit")
   if okjit and jitmod.status() then
     jitmod.opt.start("hotloop=1", "hotexit=1")
   end
-  local traces0 = jith.trace_count(256)
   for warm = 1, 128 do
     tbl[key] = warm
   end
-  local traced = jith.trace_count(256) > traces0
-  assert(ready:send(true, 10) == true)
-  local _, ok = start:recv(10)
-  assert(ok == true)
+  assert(ready:send(true, 10) == true)
+  local _, ok = start:recv(10)
+  assert(ok == true)
+  local finish_exits = watch_worker_jit_exits(jitmod)
   local i = 1
   while i <= n do
     tbl[key] = i
     if i % 257 == 0 then tbl[key + 64] = nil end
     i = i + 1
   end
-  return true, traced and 1 or 0
+  return true, finish_exits()
 end
 
