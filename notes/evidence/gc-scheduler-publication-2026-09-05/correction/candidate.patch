--- a/tests/t-gc2-worker-scheduler.c
+++ b/tests/t-gc2-worker-scheduler.c
@@ -193,6 +193,22 @@
   int i;
   for (i = 0; i < 1000; i++) {
     if (lj_gc2_ismarked(g, o) == 1)
+      return 1;
+    sleep_ns(1000000L);
+  }
+  return 0;
+}
+
+/* A flush may refuse when both owner buffers are in use and a worker owns
+** recycling. Establish publication before observing independent worker drain;
+** a below-capacity suffix otherwise stays private to this live VM owner. */
+static int publish_owner_ssb(global_State *g, TGState *tg)
+{
+  int i;
+  for (i = 0; i < 1000; i++) {
+    if (lj_tg_ssb_next_acq(tg) == lj_tg_ssb_base_acq(tg))
+      return 1;
+    if (lj_gc2_flush_ssb(g, tg) != 0)
       return 1;
     sleep_ns(1000000L);
   }
@@ -1258,9 +1274,8 @@
   grey0 = gc2_worker_grey_drained_acq(g);
 
   assert(lj_gc2_markobj(g, obj2gco(parent)) == 1);
-  /* Setup/store rescans may share or fill this suffix and publish it before
-  ** the explicit flush. The semantic assertion is eventual graph progress. */
-  (void)lj_gc2_flush_ssb(g, tg);
+  /* Setup/store rescans may already have published part of this graph. */
+  assert(publish_owner_ssb(g, tg));
   assert(wait_until_marked(g, obj2gco(grandchild)));
   assert(wait_ssb_empty(g));
   assert(gc2_worker_async_progress_acq(g) > async0);
